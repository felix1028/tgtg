# Too Good To Go Account Email
TGTG_EMAIL=your_email@example.com

# Credentials will be populated automatically when running auth
TGTG_ACCESS_TOKEN=
TGTG_REFRESH_TOKEN=
TGTG_USER_ID=
TGTG_COOKIE=

# Notification options (WhatsApp via CallMeBot)
# 1. Add CallMeBot to WhatsApp: +34 684 770 005
#    (or open: https://wa.me/34684770005?text=I%20allow%20callmebot%20to%20send%20me%20messages)
# 2. Send: "I allow callmebot to send me messages"
# 3. Enter your phone number with country code (e.g. +1234567890) and the received API key:
WHATSAPP_PHONE=
WHATSAPP_APIKEY=
